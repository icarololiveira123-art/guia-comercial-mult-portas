{
  "name": "guia-comercial-mult-portas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "npm run build && bash scripts/sites-env.sh -- vite preview --host 127.0.0.1",
    "test": "bash scripts/test-verified.sh",
    "test:e2e": "bash scripts/test-e2e-local.sh",
    "build:github": "node scripts/build-github-integrated.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern dist-pages --ignore-pattern .next",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit --incremental false",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "postinstall": "node scripts/patch-braces.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.143.1"
  },
  "overrides": {
    "image-size": "2.0.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "type": "module",
  "displayName": "Guia Comercial Mult Portas"
}
